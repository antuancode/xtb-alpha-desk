# Copia este archivo como .env junto al docker-compose.yml

# OBLIGATORIA. Clave usada para cifrar credenciales y firmar la sesión del panel.
# Genérala con: openssl rand -hex 32
ALPHADESK_SECRET=

# OBLIGATORIA. Contraseña de acceso al panel (mínimo 8 caracteres).
ALPHADESK_PASSWORD=

# Opcional: credenciales de XTB. Si están definidas, tienen prioridad
# sobre las guardadas desde el panel y no se pueden cambiar desde la web.
XTB_USER_ID=
XTB_PASSWORD=
XTB_ACCOUNT=real

# Carpeta de datos persistentes (SQLite). En Docker se monta en /data
ALPHADESK_DATA_DIR=/data
